{
  "name": "cc-account",
  "version": "0.4.0",
  "description": "Switch Claude Code accounts in one command and keep working when one hits its usage limit: no browser login per switch, renewals before a login expires, automatic rotation with cc-pace. Zero dependencies.",
  "keywords": [
    "claude-code",
    "claude",
    "claude-code-plugin",
    "account-switcher",
    "multi-account",
    "usage-limit",
    "rate-limit",
    "oauth",
    "cc-pace",
    "cli"
  ],
  "type": "module",
  "bin": {
    "cc-account": "bin/cc-account.js"
  },
  "exports": {
    ".": "./src/accounts.js"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    ".claude-plugin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Giovanni Sasso <gsasso.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poisons77/cc-account.git"
  },
  "bugs": {
    "url": "https://github.com/poisons77/cc-account/issues"
  },
  "homepage": "https://github.com/poisons77/cc-account#readme"
}
